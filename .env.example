# Team MCP Gateway Environment Variables
# Copy this file to .env and fill in the values

# Gateway Configuration
GATEWAY_PORT=8788
# Bind to loopback in dev; set to tailnet IP (100.x.y.z) for remote testing
# NEVER set to 0.0.0.0
GATEWAY_BIND_ADDR=127.0.0.1

# Tailscale CLI path (auto-detected if on PATH)
# macOS: /Applications/Tailscale.app/Contents/MacOS/Tailscale
# TAILSCALE_CLI=/usr/local/bin/tailscale

# GitHub Personal Access Token (fine-grained, read-only Contents + Metadata)
# Only needed for GitHub MCP server demo
# GITHUB_PERSONAL_ACCESS_TOKEN=

# Logging
LOG_LEVEL=info
# Set to true to redact tool arguments/results in activity log (recommended)
REDACT_TOOL_PAYLOADS=true